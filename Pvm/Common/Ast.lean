/-
The decoded PVM instruction set: the mnemonics of GP §"Instruction Tables", by operand group.
Opcode numbers belong to each ISA (`Pvm.Isa`).

Operands are post-decode:
  * register nibbles are already clamped to `Fin 13`;
  * immediates are already sign-extended to 64 bits (`Val`);
  * offset instructions carry their *resolved* target address (`ı + sext(offset)`) in a `Val`.
-/
import Pvm.Common.Types

namespace Pvm

inductive Instr
  | trap
  | fallthrough
  | unlikely
  | ecalli          (x : Val)
  | loadImm64       (a : Reg) (x : Val)
  | storeImmU8      (addr val : Val)
  | storeImmU16     (addr val : Val)
  | storeImmU32     (addr val : Val)
  | storeImmU64     (addr val : Val)
  | jump            (target : Val)
  | jumpInd         (a : Reg) (x : Val)
  | loadImm         (a : Reg) (x : Val)
  | loadU8          (a : Reg) (x : Val)
  | loadI8          (a : Reg) (x : Val)
  | loadU16         (a : Reg) (x : Val)
  | loadI16         (a : Reg) (x : Val)
  | loadU32         (a : Reg) (x : Val)
  | loadI32         (a : Reg) (x : Val)
  | loadU64         (a : Reg) (x : Val)
  | storeU8         (a : Reg) (x : Val)
  | storeU16        (a : Reg) (x : Val)
  | storeU32        (a : Reg) (x : Val)
  | storeU64        (a : Reg) (x : Val)
  | storeImmIndU8   (a : Reg) (x val : Val)
  | storeImmIndU16  (a : Reg) (x val : Val)
  | storeImmIndU32  (a : Reg) (x val : Val)
  | storeImmIndU64  (a : Reg) (x val : Val)
  | loadImmJump     (a : Reg) (x target : Val)
  | branchEqImm     (a : Reg) (x target : Val)
  | branchNeImm     (a : Reg) (x target : Val)
  | branchLtUImm    (a : Reg) (x target : Val)
  | branchLeUImm    (a : Reg) (x target : Val)
  | branchGeUImm    (a : Reg) (x target : Val)
  | branchGtUImm    (a : Reg) (x target : Val)
  | branchLtSImm    (a : Reg) (x target : Val)
  | branchLeSImm    (a : Reg) (x target : Val)
  | branchGeSImm    (a : Reg) (x target : Val)
  | branchGtSImm    (a : Reg) (x target : Val)
  | moveReg            (d a : Reg)
  | countSetBits64     (d a : Reg)
  | countSetBits32     (d a : Reg)
  | leadingZeroBits64  (d a : Reg)
  | leadingZeroBits32  (d a : Reg)
  | trailingZeroBits64 (d a : Reg)
  | trailingZeroBits32 (d a : Reg)
  | signExtend8        (d a : Reg)
  | signExtend16       (d a : Reg)
  | zeroExtend16       (d a : Reg)
  | reverseBytes       (d a : Reg)
  | storeIndU8      (a b : Reg) (x : Val)
  | storeIndU16     (a b : Reg) (x : Val)
  | storeIndU32     (a b : Reg) (x : Val)
  | storeIndU64     (a b : Reg) (x : Val)
  | loadIndU8       (a b : Reg) (x : Val)
  | loadIndI8       (a b : Reg) (x : Val)
  | loadIndU16      (a b : Reg) (x : Val)
  | loadIndI16      (a b : Reg) (x : Val)
  | loadIndU32      (a b : Reg) (x : Val)
  | loadIndI32      (a b : Reg) (x : Val)
  | loadIndU64      (a b : Reg) (x : Val)
  | addImm32        (a b : Reg) (x : Val)
  | andImm          (a b : Reg) (x : Val)
  | xorImm          (a b : Reg) (x : Val)
  | orImm           (a b : Reg) (x : Val)
  | mulImm32        (a b : Reg) (x : Val)
  | setLtUImm       (a b : Reg) (x : Val)
  | setLtSImm       (a b : Reg) (x : Val)
  | shloLImm32      (a b : Reg) (x : Val)
  | shloRImm32      (a b : Reg) (x : Val)
  | sharRImm32      (a b : Reg) (x : Val)
  | negAddImm32     (a b : Reg) (x : Val)
  | setGtUImm       (a b : Reg) (x : Val)
  | setGtSImm       (a b : Reg) (x : Val)
  | shloLImmAlt32   (a b : Reg) (x : Val)
  | shloRImmAlt32   (a b : Reg) (x : Val)
  | sharRImmAlt32   (a b : Reg) (x : Val)
  | cmovIzImm       (a b : Reg) (x : Val)
  | cmovNzImm       (a b : Reg) (x : Val)
  | addImm64        (a b : Reg) (x : Val)
  | mulImm64        (a b : Reg) (x : Val)
  | shloLImm64      (a b : Reg) (x : Val)
  | shloRImm64      (a b : Reg) (x : Val)
  | sharRImm64      (a b : Reg) (x : Val)
  | negAddImm64     (a b : Reg) (x : Val)
  | shloLImmAlt64   (a b : Reg) (x : Val)
  | shloRImmAlt64   (a b : Reg) (x : Val)
  | sharRImmAlt64   (a b : Reg) (x : Val)
  | rotR64Imm       (a b : Reg) (x : Val)
  | rotR64ImmAlt    (a b : Reg) (x : Val)
  | rotR32Imm       (a b : Reg) (x : Val)
  | rotR32ImmAlt    (a b : Reg) (x : Val)
  | branchEq        (a b : Reg) (target : Val)
  | branchNe        (a b : Reg) (target : Val)
  | branchLtU       (a b : Reg) (target : Val)
  | branchLtS       (a b : Reg) (target : Val)
  | branchGeU       (a b : Reg) (target : Val)
  | branchGeS       (a b : Reg) (target : Val)
  | loadImmJumpInd  (a b : Reg) (x target : Val)
  | add32           (a b d : Reg)
  | sub32           (a b d : Reg)
  | mul32           (a b d : Reg)
  | divU32          (a b d : Reg)
  | divS32          (a b d : Reg)
  | remU32          (a b d : Reg)
  | remS32          (a b d : Reg)
  | shloL32         (a b d : Reg)
  | shloR32         (a b d : Reg)
  | sharR32         (a b d : Reg)
  | add64           (a b d : Reg)
  | sub64           (a b d : Reg)
  | mul64           (a b d : Reg)
  | divU64          (a b d : Reg)
  | divS64          (a b d : Reg)
  | remU64          (a b d : Reg)
  | remS64          (a b d : Reg)
  | shloL64         (a b d : Reg)
  | shloR64         (a b d : Reg)
  | sharR64         (a b d : Reg)
  | and             (a b d : Reg)
  | xor             (a b d : Reg)
  | or              (a b d : Reg)
  | mulUpperSS      (a b d : Reg)
  | mulUpperUU      (a b d : Reg)
  | mulUpperSU      (a b d : Reg)
  | setLtU          (a b d : Reg)
  | setLtS          (a b d : Reg)
  | cmovIz          (a b d : Reg)
  | cmovNz          (a b d : Reg)
  | rotL64          (a b d : Reg)
  | rotL32          (a b d : Reg)
  | rotR64          (a b d : Reg)
  | rotR32          (a b d : Reg)
  | andInv          (a b d : Reg)
  | orInv           (a b d : Reg)
  | xnor            (a b d : Reg)
  | max             (a b d : Reg)
  | maxU            (a b d : Reg)
  | min             (a b d : Reg)
  | minU            (a b d : Reg)
  deriving DecidableEq, Repr, Inhabited

/-- T (GP ~108). -/
def Instr.isTerminator : Instr → Bool
  | .trap | .fallthrough
  | .jump _ | .jumpInd _ _
  | .loadImmJump _ _ _ | .loadImmJumpInd _ _ _ _
  | .branchEqImm _ _ _ | .branchNeImm _ _ _
  | .branchLtUImm _ _ _ | .branchLeUImm _ _ _ | .branchGeUImm _ _ _ | .branchGtUImm _ _ _
  | .branchLtSImm _ _ _ | .branchLeSImm _ _ _ | .branchGeSImm _ _ _ | .branchGtSImm _ _ _
  | .branchEq _ _ _ | .branchNe _ _ _
  | .branchLtU _ _ _ | .branchLtS _ _ _ | .branchGeU _ _ _ | .branchGeS _ _ _ => true
  | _ => false

end Pvm
